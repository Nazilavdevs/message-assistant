
{
  "manifest_version": 3,
  "name": "LinkedIn Message Assistant",
  "version": "0.2.0",
  "description": "Review LinkedIn profiles one at a time.",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open LinkedIn Message Assistant"
  },
  "side_panel": {
    "default_path": "queue.html"
  }
}
