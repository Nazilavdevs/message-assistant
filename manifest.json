
{
  "manifest_version": 3,
  "name": "LinkedIn Message Assistant",
  "version": "0.1.0",
  "description": "Manage LinkedIn profile URLs and prepare message drafts.",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open LinkedIn Message Assistant"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
